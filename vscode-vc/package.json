{
  "name": "vc",
  "displayName": "VC Language Support",
  "description": "Syntax highlighting for the VC language — a CUDA-like language targeting Vulkan via MLIR/SPIR-V.",
  "version": "0.1.0",
  "publisher": "vc-lang",
  "license": "MIT",
  "icon": "icons/vc-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/junka/gg.git",
    "directory": "vscode-vc"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "vc",
    "cuda",
    "vulkan",
    "spir-v",
    "mlir",
    "gpu"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vc",
        "aliases": [
          "VC",
          "vc"
        ],
        "extensions": [
          ".vc"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/vc-file.png",
          "dark": "./icons/vc-file.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "vc",
        "scopeName": "source.vc",
        "path": "./syntaxes/vc.tmLanguage.json"
      }
    ]
  }
}
