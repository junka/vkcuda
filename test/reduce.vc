// test/reduce.vc — single-file block-reduce demo (kernel + host main + launch).
//
// Each workgroup of `blockDim` threads sums its slice of the input and writes
// one output element. Exercises for-loop, __shared__ memory, __syncthreads().
//
//   vcc test/reduce.vc -o build/reduce_sf && ./build/reduce_sf

#include <cstdio>
#include "vc/Runtime/VCRuntime.h"

__global__ void blockReduce(float *inBuf, float *outBuf, int N) {
  int tid = threadIdx.x;
  int block = blockDim.x;
  int start = blockIdx.x * block;
  int i = start + tid;
  int end = start + block;
  if (end > N) end = N;

  __shared__ float s[256];

  // Each thread loads one element (0 if out of range).
  if (i < N)
    s[tid] = inBuf[i];
  else
    s[tid] = 0.0;
  __syncthreads();

  // Tree reduction within the workgroup.
  for (int s2 = block / 2; s2 > 0; s2 = s2 / 2) {
    if (tid < s2) {
      s[tid] = s[tid] + s[tid + s2];
    }
    __syncthreads();
  }

  if (tid == 0)
    outBuf[blockIdx.x] = s[0];
}

int main() {
  vcInit();

  const int N = 128;
  const int block = 32;
  const int numBlocks = (N + block - 1) / block;

  float hIn[128];
  for (int i = 0; i < N; i++) hIn[i] = 1.0f * i; // 0,1,2,...,127
  float hOut[4];
  for (int b = 0; b < numBlocks; b++) hOut[b] = 0.0f;

  void *dIn = 0, *dOut = 0;
  vcMalloc(&dIn, N * 4);
  vcMalloc(&dOut, numBlocks * 4);
  vcMemcpy(dIn, hIn, N * 4, VCMemcpyKind::HostToDevice);

  // gridDim = N (element count), blockDim = block. The runtime computes
  // workgroup count = ceil(gridDim/blockDim) = numBlocks.
  blockReduce<<<N, block>>>(dIn, dOut, N);

  vcDeviceSynchronize();
  vcMemcpy(hOut, dOut, numBlocks * 4, VCMemcpyKind::DeviceToHost);

  // Expected partial sums: block b covers [b*block, min((b+1)*block, N)).
  int ok = 1;
  for (int b = 0; b < numBlocks; b++) {
    int lo = b * block;
    int hi = (b + 1) * block;
    if (hi > N) hi = N;
    float expect = 0.0f;
    for (int i = lo; i < hi; i++) expect += hIn[i];
    if (hOut[b] != expect) {
      ok = 0;
    }
  }
  printf("block_reduce: %s\n", ok ? "PASS" : "FAIL");

  vcFree(dIn);
  vcFree(dOut);
  vcShutdown();
  return ok ? 0 : 1;
}
