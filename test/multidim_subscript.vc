// test/multidim_subscript.vc — partial subscript into a multi-dim array.
//
// `b[0][i]` on a 2D array, and `v[a][b][c]` on a 3D array, require the
// type checker to know that a partial subscript of a multi-dimensional
// array yields a sub-array (one fewer dimension), not a scalar — so the
// next subscript is legal. Sema previously looked up array-ness only when
// the base was a bare DeclRefExpr, so a nested IndexExpr base (`b[0]`)
// lost the remaining dims and warned "subscripted value is not an array".
// The fix walks down a chain of IndexExprs to the underlying array decl,
// counting consumed dims; a partial subscript is legal while any dim
// remains, and the constant-index bounds check now reports the correct
// per-dimension size.
//
// Covers:
//   - `b[0][i]` / `b[1][i]` on a 2D local array (row access).
//   - `v[a][b][c]` full subscript on a 3D array filled by nested loops.
//   - constant-index out-of-bounds detection on a partial subscript
//     (reports the dimension's declared size, not the trailing one).
//
//   vcc test/multidim_subscript.vc -o build/multidim_subscript_sf && ./build/multidim_subscript_sf
//   vc  test/multidim_subscript.vc -emit=full -o build/multidim_subscript_m && ./build/multidim_subscript_m

#include <cstdio>
#include "vc/Runtime/VCRuntime.h"

__global__ void subKernel(int *out, int n) {
  int b[2][3] = {{1, 2, 3}, {4, 5, 6}};
  int i = threadIdx.x;
  if (i >= n) return;
  // b[0] and b[1] are int[3] sub-arrays; indexing column i is legal.
  out[i] = b[0][i] + b[1][i];   // row0[i] + row1[i]
}

__global__ void subKernel3D(int *out, int n) {
  int v[2][2][2];
  // Fill linearly: v[a][b][c] = a*4 + b*2 + c.
  for (int a = 0; a < 2; ++a)
    for (int bb = 0; bb < 2; ++bb)
      for (int c = 0; c < 2; ++c)
        v[a][bb][c] = a * 4 + bb * 2 + c;
  int i = threadIdx.x;
  if (i >= n) return;
  // v[0][1][0] = 2 ; v[1][0][1] = 5
  out[i] = v[0][1][0] + v[1][0][1] * 100;   // 2 + 500 = 502
}

int main() {
  vcInit();
  void *d = 0;
  vcMalloc(&d, 16);

  subKernel<<<1, 3>>>(d, 3);
  vcDeviceSynchronize();
  int h[4] = {0};
  vcMemcpy(h, d, 16, VCMemcpyKind::DeviceToHost);
  int ok = h[0] == 5 && h[1] == 7 && h[2] == 9;   // 1+4, 2+5, 3+6

  subKernel3D<<<1, 1>>>(d, 1);
  vcDeviceSynchronize();
  vcMemcpy(h, d, 4, VCMemcpyKind::DeviceToHost);
  ok = ok && h[0] == 502;

  printf("multidim_subscript: %s\n", ok ? "PASS" : "FAIL");

  vcFree(d);
  vcShutdown();
  return ok ? 0 : 1;
}
