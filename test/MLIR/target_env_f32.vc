// test/MLIR/target_env_f32.vc — the target env advertises only what the source
// uses.
//
// A SPIR-V capability must be backed by the matching Vulkan device feature or
// vkCreateShaderModule refuses the whole binary, so declaring Float64 / Int64 /
// Float16 for a kernel that touches none of those widths makes an ordinary f32
// kernel unloadable on a device without doubles. The capability list is
// therefore derived from the module's types (VCToGPU.cpp scanWidthUses).
//
// The list is only observable in the serialized module — -emit=mlir dumps the
// VC-dialect IR, which predates the gpu.module and its spirv.target_env — so
// this test decodes the OpCapability records out of the binary.
//
// RUN: mlirc -emit=spirv %s -o %t.spv && python3 "$(dirname "%s")/spirv_capabilities.py" %t.spv | FileCheck %s

__global__ void scale(float *out, float *in, int n) {
  int i = blockIdx.x * blockDim.x + threadIdx.x;
  // `0.0` is a double literal by C rules, but the value only ever lives in a
  // float. The emitter folds such an immediate to the target width instead of
  // keeping an f64 constant and its truncf — either one in the IR would make
  // this f32 kernel declare Float64.
  float acc = 0.0;
  if (i < n)
    out[i] = in[i] * 2.0f + acc;
}

// Shader is the first capability the emitter pushes, so the CHECK-NOT window
// that follows it spans the rest of the list.
// CHECK:      capability Shader
// CHECK-NOT:  Float64
// CHECK-NOT:  Int64
// CHECK-NOT:  Float16
