// test/MLIR/target_env_widths.vc — the widths a kernel uses get their
// capabilities advertised.
//
// GPUToSPIRV refuses ops on f64/i64 unless the target env declares Float64 /
// Int64, so `double` and `long` must flip exactly those two entries on — and
// nothing else. The second half of that contract (no Float16 for a module that
// never mentions half) is what keeps the binary loadable on a device without
// shaderFloat16; see target_env_f32.vc for the f32-only case.
//
// RUN: mlirc -emit=spirv %s -o %t.spv && python3 "$(dirname "%s")/spirv_capabilities.py" %t.spv | FileCheck %s

__global__ void widen(double *out, long *counts, int n) {
  int i = threadIdx.x;
  double d = (double)n * 1.5;
  long l = (long)n + 7L;
  out[i] = d;
  counts[i] = l;
}

// The emitter pushes Shader, then Float64, Int64 and Float16 in that order, so
// matching the first two proves the derived list has no gaps.
// CHECK:      capability Shader
// CHECK:      Float64
// CHECK:      Int64
// CHECK-NOT:  Float16
