// test/MLIR/zz_dump_f64.vc — TEMPORARY debug aid, delete before merging.
//
// f64_math_warn.vc does not see the reduced-precision warning from the MLIR
// backend. This file forces the CI log to show the complete captured output
// (IR plus every diagnostic) for the same source, so the actual lowering of
// `sin(double)` can be inspected. It fails on purpose: the sentinel below is
// never printed, and FileCheck's --dump-input then echoes the whole input.
//
// RUN: mlirc -emit=mlir %s 2>&1 | FileCheck %s --dump-input=always --dump-input-filter=all

__global__ void k(float *out, int n) {
  int tid = threadIdx.x;
  double d = (double)n + 1.5;
  double a = sin(d);
  double b = pow(d, 2.0);
  out[tid] = (float)(a * b);
}

// CHECK: @@FULL_DUMP_SENTINEL@@
