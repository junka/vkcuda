// test/MLIR/wmma_tile_offset.vc - tiled WMMA lowering: non-origin tile origin.
//
// A cooperative-matrix GEMM needs more than one tile: each workgroup must be
// able to name a tile whose (0,0) element is somewhere inside the operand
// buffer. gpu.subgroup_mma_{load,store}_matrix carry a Variadic<Index>:$indices
// operand for exactly this, and the frontend produces it from any of the
// buffer-plus-displacement spellings a CUDA programmer writes -- `A + row * LD
// + k`, `&C[o]`, or a derived pointer local `p + k`.
//
// This test pins that lowering: the index operand must reach the op, and the
// leading dimension must survive as a static attribute next to it.
//
// RUN: mlirc -emit=mlir %s 2>&1 | FileCheck %s

__global__ void kern(half *A, float *C, int n) {
  wmma::fragment<wmma::matrix_a, 8, 8, 16, half, wmma::row_major> a;
  wmma::fragment<wmma::matrix_b, 8, 8, 16, half, wmma::row_major> b;
  wmma::fragment<wmma::accumulator, 8, 8, 16, float> c;

  // Expression form: `A + n * 64 + 16` accumulates into one element offset.
  // CHECK: arith.muli
  // CHECK: arith.addi
  // CHECK: gpu.subgroup_mma_load_matrix %{{.*}}[%{{.*}}] {leadDimension = 64 : index}
  wmma::load_matrix_sync(a, A + n * 64 + 16, 64);
  wmma::load_matrix_sync(b, A + n * 64, 64);

  // Address-of form: `&C[o]`.
  // CHECK: gpu.subgroup_mma_load_matrix %{{.*}}[%{{.*}}] {leadDimension = 64 : index}
  wmma::load_matrix_sync(c, &C[n * 64 + 8], 64, wmma::mem_row_major);

  // CHECK: gpu.subgroup_mma_compute
  wmma::mma_sync(c, a, b, c);

  // Store side takes the same offset operand.
  // CHECK: gpu.subgroup_mma_store_matrix %{{.*}}, %{{.*}}[%{{.*}}] {leadDimension = 64 : index}
  wmma::store_matrix_sync(C + n * 64 + 8, c, 64, wmma::mem_row_major);
}
