// test/graph.vc — command-graph record/replay (CUDA-Graph-style).
//
// Exercises the runtime's vcGraph* API: record a sequence of kernel launches
// and a device-to-device copy into a reusable command graph, then replay it
// multiple times with a single queue submit each time. This is a runtime-
// layer feature (independent of the GLSL/MLIR backend), so the same source
// runs on both.
//
//   vcc test/graph.vc -o build/graph_sf && ./build/graph_sf
//   vc  test/graph.vc -emit=full -o build/graph_m && ./build/graph_m
//
// Graph captured:
//   step1: c[i] = a[i] + b[i]        (launch vadd)
//   copy : d[i] = c[i]               (D2D copy, device->device)
//   step2: e[i] = d[i] * 2 + 1       (launch vscale)
// Replayed N times into the same buffers (accumulating), verifying the host
// sees the correct composed result after each replay + sync.

#include <cstdio>
#include "vc/Runtime/VCRuntime.h"

__global__ void vadd(float *a, float *b, float *c, int n) {
  int i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < n) c[i] = a[i] + b[i];
}

__global__ void vscale(float *d, float *e, int n) {
  int i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < n) e[i] = d[i] * 2.0f + 1.0f;
}

int main() {
  vcInit();

  const int N = 64;
  const int bytes = N * 4;
  float hA[64], hB[64], hE[64];
  for (int i = 0; i < N; i++) { hA[i] = 1.0f; hB[i] = 1.0f; }

  void *dA = 0, *dB = 0, *dC = 0, *dD = 0, *dE = 0;
  vcMalloc(&dA, bytes);
  vcMalloc(&dB, bytes);
  vcMalloc(&dC, bytes);
  vcMalloc(&dD, bytes);
  vcMalloc(&dE, bytes);

  vcMemcpy(dA, hA, bytes, VCMemcpyKind::HostToDevice);
  vcMemcpy(dB, hB, bytes, VCMemcpyKind::HostToDevice);

  // Record a graph: vadd -> D2D copy (c->d) -> vscale (d->e).
  VCGraphHandle graph = 0;
  vcGraphCreate(&graph);
  vcGraphBeginRecord(graph);
  vadd<<<N, 32>>>(dA, dB, dC, N);
  vcMemcpy(dD, dC, bytes, VCMemcpyKind::DeviceToDevice);
  vscale<<<N, 32>>>(dD, dE, N);
  vcGraphEndRecord(graph);

  // Replay the graph several times. Each replay:
  //   c = a+b = 2 ; d = c = 2 ; e = d*2+1 = 5
  // a and b are constant, so e should be 5 every time (idempotent under
  // re-run since outputs e don't feed back into a/b). This verifies replay
  // correctness: descriptor sets + push constants recorded once must still
  // resolve correctly on each replay.
  int ok = 1;
  for (int r = 0; r < 5; r++) {
    vcGraphLaunch(graph, 0);
    vcDeviceSynchronize();
    vcMemcpy(hE, dE, bytes, VCMemcpyKind::DeviceToHost);
    for (int i = 0; i < N; i++) {
      if (hE[i] != 5.0f) { ok = 0; break; }
    }
  }

  printf("graph: %s\n", ok ? "PASS" : "FAIL");

  vcGraphDestroy(graph);
  vcFree(dA);
  vcFree(dB);
  vcFree(dC);
  vcFree(dD);
  vcFree(dE);
  vcShutdown();
  return ok ? 0 : 1;
}
