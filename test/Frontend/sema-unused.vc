// RUN: vcc -fsyntax-only %s 2>&1 | FileCheck %s
//
// Unused variables and unused parameters are reported when their scope ends.
// A variable only ever written (but never read) still counts as unused.
// Diagnostics are grouped by scope (inner scopes pop first) and not
// source-ordered, so checks use CHECK-DAG.

__global__ void kern(float *out) {
  // x is read by the `if` below: never reported.
  int x = 1;
  // y is declared and never touched: reported.
  // CHECK-DAG: warning: unused variable 'y'
  float y;
  // z is written then read (z + 1): never reported.
  int z = 2;
  z = 3;
  out[0] = (float)(z + 1);

  // w is written but never read: still reported as unused.
  // CHECK-DAG: warning: unused variable 'w'
  int w = 5;
  w = 6;

  // A store-only variable: its only reference is the store, so it is unused.
  // CHECK-DAG: warning: unused variable 'set_only'
  float set_only = 0.0f;
  set_only = out[3];

  if (x > 0) {
    // CHECK-DAG: warning: unused variable 'inner'
    float inner = 1.0f;
  }

  // Read at the top of each iteration, written at the bottom: the last
  // statement naming it is a store, but the next iteration reads it, so it is
  // used. Reported as unused before the store-clears-the-flag rule was dropped.
  float cur = 1.0f;
  for (int i = 0; i < 4; i = i + 1) {
    float nxt = cur + 1.0f;
    out[4] = nxt;
    cur = nxt;
  }

  // Used variables do not warn.
  int used_v = 42;
  out[1] = (float)used_v;
}

__device__ void helper(float helper_param) {
  // CHECK-DAG: warning: unused parameter 'helper_param'
  // CHECK-DAG: warning: unused variable 'helper_local'
  float helper_local = 1.0f;
  // Neither is used; both reported when helper's scope pops.
}

// `cur` must not be reported: a store at the end of the loop body does not make
// a loop-carried variable unused. CHECK-NOT: unused variable 'cur'
// CHECK-NOT: unused variable 'nxt'
