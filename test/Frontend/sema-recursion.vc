// RUN: vcc -fsyntax-only %s 2>&1 | FileCheck %s
//
// Recursion in device code: SPIR-V forbids it, so it is not accepted as-is —
// but a *bounded linear* self-recursion is rewritten to an iterative
// accumulator loop by the AstTransforms pass (unrollDeviceRecursion) before
// codegen, so Sema accepts it (it only marks the function `isRecursive`).
// Shapes the pass cannot rewrite — here branching recursion (two self-calls) —
// are rejected with a hard error, so unsupported recursion still fails loudly
// instead of emitting illegal SPIR-V.
//
// Indirect recursion (f -> g -> f) is NOT yet detected.

// Bounded linear self-recursion: accepted, rewritten to a loop by the pass.
// No diagnostic for this function.
__device__ int fact(int n) {
  if (n <= 1) return 1;
  return n * fact(n - 1);
}

// Branching recursion: two self-calls in the return expression, which the
// iterative rewrite cannot express.
__device__ int fib(int n) {
  // CHECK: error: cannot rewrite recursive function 'fib': branching recursion
  if (n < 2) return n;
  return fib(n - 1) + fib(n - 2);
}

__global__ void kern(int *out) {
  out[0] = fact(3) + fib(5);
}
