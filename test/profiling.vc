// test/profiling.vc — vcGetDeviceProperties, vcPointerGetAttributes, vcEventElapsedTime.
//
// Three CUDA profiling/attribute APIs exercised:
//   vcGetDeviceProperties  — device limits (cudaGetDeviceProperties)
//   vcPointerGetAttributes — is a pointer device/host/unregistered
//                            (cudaPointerGetAttributes)
//   vcEventElapsedTime     — GPU-side elapsed time between two events
//                            (cudaEventElapsedTime)
//
//   vcc test/profiling.vc -o build/pf_sf && ./build/pf_sf
//   vc  test/profiling.vc -emit=full -o build/pf_m && ./build/pf_m

#include <cstdio>
#include "vc/Runtime/VCRuntime.h"

__global__ void heavyWork(float *a, int n) {
  int i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < n) {
    float v = a[i];
    // A bit of arithmetic per element so the kernel takes measurable time.
    for (int k = 0; k < 64; ++k) {
      v = v * 1.0001f + 0.0001f;
    }
    a[i] = v;
  }
}

int main() {
  vcInit();

  // ---- 1. vcGetDeviceProperties ----
  VCDeviceProperties props;
  if (vcGetDeviceProperties(&props, 0) != VCError::Success) {
    printf("profiling: FAIL (getDeviceProperties)\n");
    return 1;
  }
  printf("device: %s\n", props.name);
  printf("  warpSize=%d maxThreadsPerBlock=%d sharedMemPerBlock=%zu\n",
         props.warpSize, props.maxThreadsPerBlock, props.sharedMemPerBlock);
  printf("  maxThreadsDim=(%d,%d,%d) maxGridSize=(%d,%d,%d)\n",
         props.maxThreadsDim[0], props.maxThreadsDim[1], props.maxThreadsDim[2],
         props.maxGridSize[0], props.maxGridSize[1], props.maxGridSize[2]);
  printf("  totalGlobalMem=%zu multiProcessorCount=%d\n",
         props.totalGlobalMem, props.multiProcessorCount);
  // Sanity: a compute device must allow at least 32 threads/block and have a
  // positive subgroup size and global memory.
  if (props.warpSize < 1 || props.maxThreadsPerBlock < 32 ||
      props.totalGlobalMem == 0) {
    printf("profiling: FAIL (device properties implausible)\n");
    return 1;
  }

  // ---- 2. vcPointerGetAttributes ----
  float *devP = 0;
  vcMalloc((void **)&devP, 1024 * 4);
  float *hostP = 0;
  vcMallocHost((void **)&hostP, 512 * 4);
  int stackVar = 42;

  VCPointerAttributes attr;
  // Device allocation -> Device, size matches.
  vcPointerGetAttributes(&attr, devP);
  if (attr.memoryType != VCMemoryType::Device || attr.size != 1024 * 4 ||
      attr.devicePointer != devP) {
    printf("profiling: FAIL (device ptr attr type=%d size=%zu)\n",
           (int)attr.memoryType, attr.size);
    return 1;
  }
  // Host-visible allocation -> Host, mapped host pointer non-null.
  vcPointerGetAttributes(&attr, hostP);
  if (attr.memoryType != VCMemoryType::Host || attr.size != 512 * 4 ||
      attr.hostPointer == 0) {
    printf("profiling: FAIL (host ptr attr type=%d size=%zu hostPtr=%p)\n",
           (int)attr.memoryType, attr.size, attr.hostPointer);
    return 1;
  }
  // A plain stack address -> Unregistered.
  vcPointerGetAttributes(&attr, &stackVar);
  if (attr.memoryType != VCMemoryType::Unregistered) {
    printf("profiling: FAIL (stack ptr should be unregistered, got %d)\n",
           (int)attr.memoryType);
    return 1;
  }

  // ---- 3. vcEventElapsedTime ----
  VCEventHandle start = 0, end = 0;
  vcEventCreate(&start);
  vcEventCreate(&end);

  const int N = 256 * 1024; // 1 MiB of floats — enough work to time
  float *workBuf = 0;
  vcMalloc((void **)&workBuf, N * 4);
  // Initialize to nonzero so the arithmetic loop is not trivially constant.
  vcMemset(workBuf, 1, N * 4);

  vcEventRecord(start, 0); // default stream
  heavyWork<<<(N + 255) / 256, 256>>>(workBuf, N);
  vcEventRecord(end, 0);
  vcEventSynchronize(end);

  float ms = 0.0f;
  VCError te = vcEventElapsedTime(&ms, start, end);
  if (te != VCError::Success) {
    printf("profiling: FAIL (eventElapsedTime err=%d)\n", (int)te);
    return 1;
  }
  printf("  heavyWork elapsed: %.4f ms\n", ms);
  // The kernel does real work; elapsed should be positive and bounded (no
  // more than a few seconds on any reasonable device).
  if (!(ms > 0.0f) || ms > 5000.0f) {
    printf("profiling: FAIL (elapsed out of range: %.4f ms)\n", ms);
    return 1;
  }

  // Reverse-order query (end before start) is a misuse; CUDA returns an error.
  // VC reads the two timestamps regardless of record order, so we only check
  // that the call still succeeds and produces a finite number (the magnitude
  // is meaningless when reversed). This documents the limitation.
  float msRev = 999.0f;
  vcEventElapsedTime(&msRev, end, start);
  if (msRev == 999.0f) {
    printf("profiling: FAIL (reverse elapsed not written)\n");
    return 1;
  }

  vcFree(devP);
  vcFree(hostP);
  vcFree(workBuf);
  vcEventDestroy(start);
  vcEventDestroy(end);
  vcShutdown();
  printf("profiling: PASS\n");
  return 0;
}
